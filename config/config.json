{
  "rules": {
    "server_spawned_shell": {
      "enabled": true,
      "severity": "critical",
      "server_names": ["nginx", "apache2", "httpd", "node", "python3", "java", "ruby"],
      "shell_names":  ["bash", "sh", "zsh", "dash", "fish", "cmd", "powershell", "pwsh"]
    },
    "exec_from_suspicious_path": {
      "enabled": true,
      "severity": "high",
      "suspicious_paths": ["/tmp/", "/dev/shm/", "/var/tmp/"]
    },
    "fileless_execution": {
      "enabled": true,
      "severity": "critical"
    },
    "anon_rwx_mapping": {
      "enabled": true,
      "severity": "high"
    },
    "privilege_escalation": {
      "enabled": true,
      "severity": "critical"
    }
  }
}