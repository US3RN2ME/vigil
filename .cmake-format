# cmake-format configuration
# Keep formatting predictable and close to common CMake style conventions.

line_width: 100
tab_size: 4
separate_ctrl_name_with_space: false
separate_fn_name_with_space: false
dangle_parens: false
command_case: lower
keyword_case: upper
max_subgroups_hwrap: 2
max_pargs_hwrap: 6
max_rows_cmdline: 2
autosort: true
enable_sort: true

format:
  separate_ctrl_name_with_space: false
  separate_fn_name_with_space: false
  min_prefix_chars: 4
  max_prefix_chars: 10

markup:
  enable_markup: true

encode:
  emit_byteorder_mark: false